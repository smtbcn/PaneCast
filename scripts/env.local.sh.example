# PaneCast — yerel cihaz/ağ ayarları. DEPOYA GİRMEZ (scripts/*.local.sh).
# Kopyala: cp scripts/env.local.sh.example scripts/env.local.sh  → kendi değerlerini yaz.
#
# Neden ayrı dosya: TV'nin ve Mac'in LAN adresleri açık kaynak depoya yazılmaz.
# Betikler önce ortam değişkenlerine, sonra bu dosyaya bakar; hiçbiri yoksa
# TV'yi mDNS'ten (_atvm._tcp) bulurlar. Sabit kodlanmış adres yoktur.
#
# Yalnızca düz atama kullan (export AD="değer") — betikler kabuk çalıştırmadan okur.

# TV'nin IP adresi (mDNS keşfi başarısızsa yedek olarak kullanılır).
export TV_IP=""

# ADB hedefi; boş bırakılırsa TV_IP:5555 kullanılır.
export TV_SERIAL=""

# adb yolu; PATH'te adb varsa bu satırı silebilirsin.
export ADB=""

# Medya portu (protokolde sabit 7602).
export ATVM_MEDIA_PORT="7602"
